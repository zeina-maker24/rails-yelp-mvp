<div class="container">

  <% @restaurants.each do |restaurant| %>
    <div class="card mb-3">
      <div class="card-body">
        <h3><%= restaurant.name %></h3>

        <p>
          <strong>Category:</strong>
          <%= restaurant.category %>
        </p>

        <%= link_to "See details", restaurant_path(restaurant), class: "btn btn-primary" %>
      </div>
    </div>
  <% end %>

</div>
